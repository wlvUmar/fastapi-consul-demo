# Copy to .env and adjust as needed.
# Note: HOST/PORT apply to whichever service is started with this file.
# When running all three services locally, prefer the --port flag
# (defaults already match: A=8001, B=8002, C=8003, gateway=8000).
HOST=127.0.0.1
PORT=8001

# Gateway upstreams (gateway only)
SERVICE_A_URL=http://localhost:8001
SERVICE_B_URL=http://localhost:8002
SERVICE_C_URL=http://localhost:8003
REQUEST_TIMEOUT=5.0

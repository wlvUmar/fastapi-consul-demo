# Copy to .env and adjust as needed.
# Note: HOST/PORT/SERVICE_ID apply to whichever service is started with this file.
# When running all three services locally, prefer the --port flag
# (defaults already match: A=8001, B=8002, C=8003, gateway=8000).
HOST=127.0.0.1
PORT=8001
SERVICE_ID=service-a
SERVICE_ADDRESS=127.0.0.1

# Consul agent (services register here, gateway discovers here)
CONSUL_HOST=127.0.0.1
CONSUL_PORT=8500

# Gateway only
REQUEST_TIMEOUT=5.0
